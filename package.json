{
  "name": "pulsehr",
  "private": true,
  "version": "0.1.0",
  "description": "PulseHR — Predictive Human Resource Information System (prototype)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run test -w @pulsehr/core",
    "typecheck": "tsc -b --force",
    "dev:api": "npm run dev -w @pulsehr/api",
    "dev:web": "npm run dev -w @pulsehr/web",
    "seed": "npm run seed -w @pulsehr/api",
    "job:score": "npm run job:score -w @pulsehr/api",
    "job:payroll": "npm run job:payroll -w @pulsehr/api",
    "build": "npm run build -w @pulsehr/web"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
